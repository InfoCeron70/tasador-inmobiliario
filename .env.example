# =========================================================
# Plantilla de variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
#   Windows (PowerShell):  Copy-Item .env.example .env
# NUNCA subas el archivo .env al repositorio.
# =========================================================

# ---------- Servidor ----------
PORT=3000

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=tu_clave_aqui
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# Tiempo maximo por llamada (ms). Las respuestas largas pueden tardar ~50 s.
DEEPSEEK_TIMEOUT_MS=120000

# Presupuesto de tokens de salida.
# IMPORTANTE: en los modelos con razonamiento (reasoning_content) los tokens de
# pensamiento consumen este mismo presupuesto. No bajar de 8192.
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_MAX_TOKENS_LIMITE=32768
DEEPSEEK_MAX_INTENTOS=3

# Diagnostico (opcional): 1 imprime el contenido crudo devuelto por el modelo.
# DEBUG_DEEPSEEK=1

# ---------- Base de datos (opcional) ----------
# Por defecto se usa ./tasaciones.db en la raiz del proyecto.
# DB_PATH=./tasaciones.db
